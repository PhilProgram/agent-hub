#!/usr/bin/env bash
# hub — shared library CLI for local AI agents (Claude Code, Codex, ...).
# Storage: ~/agent-hub (skills/, kb/, bus.db). Needs bash 3.2+ and sqlite3.
set -euo pipefail

HUB="${HUB_HOME:-$HOME/agent-hub}"
DB="$HUB/bus.db"
SKILLS="$HUB/skills"
KB="$HUB/kb"
# Every place an agent looks for skills. Each canonical skill dir gets a symlink in each.
# HUB_LINK_DIRS (colon-separated; a leading ~ is expanded) replaces the default list.
LINK_DIRS=()
if [ -n "${HUB_LINK_DIRS:-}" ]; then
  IFS=: read -r -a _link_dirs <<< "$HUB_LINK_DIRS"
  for _d in ${_link_dirs[@]+"${_link_dirs[@]}"}; do
    if [ -n "$_d" ]; then LINK_DIRS+=("${_d/#\~/$HOME}"); fi
  done
fi
if [ "${#LINK_DIRS[@]}" -eq 0 ]; then
  LINK_DIRS=("$HOME/.claude/skills" "$HOME/.codex/skills" "$HOME/.agents/skills")
fi

usage() {
  cat <<'USAGE'
hub — shared skills, knowledge base and message bus for local agents

  hub inbox <agent> [--all]              unread (or all) messages addressed to <agent>
  hub post <to> <subject> [body]         leave a message (sender from HUB_AGENT or --from <name>)
  hub ack <id>|all <agent>               mark a message (or all for <agent>) as read
  hub activity [n]                       last n events from all agents (default 20)
  hub log <agent> <kind> <detail>        record an event (used by hooks; agents may use it too)
  hub kb [name]                          print kb/INDEX.md, or kb/projects/<name>.md / kb/topics/<name>.md
  hub note <projects|topics>/<name> <text>   append one fact; creates the file and indexes it
  hub skill new <name>                   scaffold skills/<name>/SKILL.md from the template and link it
  hub skill list                         skills with their one-line descriptions
  hub sync                               (re)link every skill into ~/.claude/skills, ~/.codex/skills, ~/.agents/skills
                                         (or the colon-separated folders in HUB_LINK_DIRS)
  hub search <text>                      case-insensitive search across kb/ and skills/
  hub feedback [--area a] <text>         suggest an improvement to the hub (areas: kb skill cli hooks rules other)
  hub feedback list [--all] | close <id> <done|rejected|queued> [note]
  hub council run|dry-run|status|queue   the self-improvement council (see council/README.md)
  hub lint                               check skills, kb index and links (exit 1 on errors)
  hub digest <agent>                     session-start block: this project's kb facts, unread messages
  hub ask <claude|codex> <question>      ask the other agent as a subprocess (costs tokens)
  hub status                             counts and link health
USAGE
}

die() { printf 'hub: %s\n' "$*" >&2; exit 1; }
# Reject stray arguments and unknown options instead of silently ignoring them.
no_more() { [ $# -eq 0 ] || die "unexpected argument '$1' (see 'hub help')"; }
not_flag() { case "${1:-}" in -*) die "unknown option '$1' (see 'hub help')" ;; esac; }
need() { command -v "$1" >/dev/null 2>&1 || die "$1 not found"; }
need sqlite3

sq() { sqlite3 -batch "$DB" "$@"; }
# SQL string literal
# (bash 3.2 keeps the backslashes in "${1//\'/\'\'}", which broke every value with an apostrophe
#  and let one end the string early; quoting the pattern and replacement works on 3.2 and 5.x)
q() { local s=$1; s=${s//"'"/"''"}; printf "'%s'" "$s"; }

init_db() {
  if [ -f "$DB" ]; then
    # tables added after the first release; cheap no-op once they exist
    sq >/dev/null <<'SQL'
CREATE TABLE IF NOT EXISTS feedback (
  id INTEGER PRIMARY KEY,
  ts TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%SZ','now')),
  agent TEXT NOT NULL,
  project TEXT,
  area TEXT NOT NULL DEFAULT 'other',
  body TEXT NOT NULL,
  status TEXT NOT NULL DEFAULT 'open',
  resolution TEXT,
  resolved_at TEXT
);
SQL
    return 0
  fi
  sq >/dev/null <<'SQL'
PRAGMA journal_mode=WAL;
CREATE TABLE IF NOT EXISTS messages (
  id INTEGER PRIMARY KEY,
  ts TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%SZ','now')),
  from_agent TEXT NOT NULL,
  to_agent TEXT NOT NULL,
  project TEXT,
  subject TEXT NOT NULL,
  body TEXT,
  read_at TEXT
);
CREATE TABLE IF NOT EXISTS events (
  id INTEGER PRIMARY KEY,
  ts TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%SZ','now')),
  agent TEXT NOT NULL,
  project TEXT,
  kind TEXT NOT NULL,
  detail TEXT
);
CREATE INDEX IF NOT EXISTS messages_to_unread ON messages(to_agent, read_at);
CREATE TABLE IF NOT EXISTS feedback (
  id INTEGER PRIMARY KEY,
  ts TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%SZ','now')),
  agent TEXT NOT NULL,
  project TEXT,
  area TEXT NOT NULL DEFAULT 'other',
  body TEXT NOT NULL,
  status TEXT NOT NULL DEFAULT 'open',
  resolution TEXT,
  resolved_at TEXT
);
SQL
}
init_db

# Project = the nearest directory (cwd or an ancestor) that has kb/projects/<name>.md,
# so a session started in a subfolder still finds its project. Falls back to basename(cwd).
project_name() {
  local d="${HUB_PROJECT:-$PWD}"
  while [ -n "$d" ] && [ "$d" != "/" ] && [ "$d" != "$HOME" ]; do
    [ -f "$KB/projects/$(basename "$d").md" ] && { basename "$d"; return 0; }
    d=$(dirname "$d")
  done
  basename "${HUB_PROJECT:-$PWD}"
}

cmd_inbox() {
  local agent="${1:-}"; [ -n "$agent" ] || die "usage: hub inbox <agent> [--all]"
  not_flag "$agent"
  case "${2:-}" in ''|--all) ;; *) die "unknown option '$2' (usage: hub inbox <agent> [--all])" ;; esac
  [ $# -le 2 ] || die "unexpected argument '$3'"
  local where="to_agent=$(q "$agent")"
  [ "${2:-}" = "--all" ] || where="$where AND read_at IS NULL"
  local n; n=$(sq "SELECT count(*) FROM messages WHERE $where")
  if [ "$n" = "0" ]; then echo "inbox ($agent): empty"; return 0; fi
  echo "inbox ($agent): $n message(s)"
  sq "SELECT '#'||id||'  '||ts||'  from '||from_agent||coalesce('  ['||project||']','')||'  '||subject||char(10)||coalesce('    '||replace(body,char(10),char(10)||'    '),'') FROM messages WHERE $where ORDER BY id"
}

cmd_post() {
  local from="${HUB_AGENT:-}"
  if [ "${1:-}" = "--from" ]; then [ $# -ge 2 ] || die "--from needs a name"; from="$2"; shift 2; fi
  not_flag "${1:-}"
  [ $# -le 3 ] || die "too many arguments: quote the subject and body"
  local to="${1:-}" subject="${2:-}" body="${3:-}"
  [ -n "$to" ] && [ -n "$subject" ] || die "usage: hub post [--from <me>] <to> <subject> [body]"
  [ -n "$from" ] || die "sender unknown: set HUB_AGENT or pass --from <me>"
  [ "$body" = "-" ] && body=$(cat)
  local id; id=$(sq "INSERT INTO messages(from_agent,to_agent,project,subject,body) VALUES($(q "$from"),$(q "$to"),$(q "$(project_name)"),$(q "$subject"),$(q "$body")); SELECT last_insert_rowid();")
  echo "posted #$id to $to"
}

cmd_ack() {
  local id="${1:-}"; [ -n "$id" ] || die "usage: hub ack <id>|all <agent>"
  if [ "$id" = "all" ]; then
    local agent="${2:-}"; [ -n "$agent" ] || die "usage: hub ack all <agent>"
    not_flag "$agent"; [ $# -le 2 ] || die "unexpected argument '$3'"
    sq "UPDATE messages SET read_at=strftime('%Y-%m-%dT%H:%M:%SZ','now') WHERE to_agent=$(q "$agent") AND read_at IS NULL"
  else
    case "$id" in *[!0-9]*) die "message id must be a number" ;; esac
    [ $# -le 1 ] || die "unexpected argument '$2'"
    sq "UPDATE messages SET read_at=strftime('%Y-%m-%dT%H:%M:%SZ','now') WHERE id=$id"
  fi
  echo "acked"
}

cmd_log() {
  local agent="${1:-}" kind="${2:-}" detail="${3:-}"
  [ -n "$agent" ] && [ -n "$kind" ] || die "usage: hub log <agent> <kind> [detail]"
  not_flag "$agent"; not_flag "$kind"
  [ $# -le 3 ] || die "too many arguments: quote the detail"
  sq "INSERT INTO events(agent,project,kind,detail) VALUES($(q "$agent"),$(q "$(project_name)"),$(q "$kind"),$(q "$detail"))"
}

cmd_activity() {
  local n="${1:-20}"
  case "$n" in ''|*[!0-9]*) die "usage: hub activity [n]  (n is a number)" ;; esac
  [ $# -le 1 ] || die "unexpected argument '$2'"
  sq "SELECT ts||'  '||agent||coalesce('  ['||project||']','')||'  '||kind||coalesce('  '||substr(replace(detail,char(10),' '),1,160),'') FROM events ORDER BY id DESC LIMIT $n"
}

kb_path() {
  local name="$1"
  case "$name" in
    projects/*|topics/*) echo "$KB/$name.md" ;;
    *) if [ -f "$KB/projects/$name.md" ]; then echo "$KB/projects/$name.md";
       elif [ -f "$KB/topics/$name.md" ]; then echo "$KB/topics/$name.md";
       else echo "$KB/topics/$name.md"; fi ;;
  esac
}

cmd_kb() {
  if [ -z "${1:-}" ]; then cat "$KB/INDEX.md"; return 0; fi
  not_flag "$1"; [ $# -le 1 ] || die "unexpected argument '$2'"
  local f; f=$(kb_path "$1")
  [ -f "$f" ] || die "no kb file for '$1' (would be $f)"
  cat "$f"
}

index_add() {
  local rel="$1" name; name=$(basename "$rel" .md)
  grep -q "($rel)" "$KB/INDEX.md" && return 0
  local section; case "$rel" in projects/*) section="## Projects" ;; *) section="## Topics" ;; esac
  # put the link right after its section header
  awk -v sec="$section" -v line="- [$name]($rel)" '{ print } $0==sec { print line }' "$KB/INDEX.md" > "$KB/INDEX.md.tmp"
  mv "$KB/INDEX.md.tmp" "$KB/INDEX.md"
}

cmd_note() {
  local target="${1:-}" text="${2:-}"
  [ -n "$target" ] && [ -n "$text" ] || die "usage: hub note <projects|topics>/<name> <text>"
  case "$target" in projects/*|topics/*) ;; *) die "target must start with projects/ or topics/" ;; esac
  case "${target#*/}" in ''|*[!A-Za-z0-9._-]*|.*) die "name after projects/ or topics/ must be letters, digits, . _ - only" ;; esac
  [ $# -le 2 ] || die "too many arguments: put the whole fact in quotes"
  local f="$KB/$target.md"
  mkdir -p "$(dirname "$f")"
  [ -f "$f" ] || printf '# %s\n\n' "$(basename "$target")" > "$f"
  # agents often end a note with its own "(YYYY-MM-DD ...)"; don't stack a second date on it
  local re='\([0-9]{4}-[0-9]{2}-[0-9]{2}[^)]*\)[[:space:]]*$'
  if [[ "$text" =~ $re ]]; then
    printf -- '- %s\n' "$text" >> "$f"
  else
    printf -- '- %s (%s%s)\n' "$text" "$(date +%Y-%m-%d)" "${HUB_AGENT:+, $HUB_AGENT}" >> "$f"
  fi
  index_add "$target.md"
  echo "noted in $target.md"
}

link_skill() {
  local name="$1" d dst src
  src="$SKILLS/$name"
  for d in "${LINK_DIRS[@]}"; do
    mkdir -p "$d"; dst="$d/$name"
    if [ -L "$dst" ]; then
      [ "$(readlink "$dst")" = "$src" ] || ln -sfn "$src" "$dst"
    elif [ -e "$dst" ]; then
      echo "  skip $dst: exists and is not a link (move it into $SKILLS to share it)" >&2
    else
      ln -s "$src" "$dst"
    fi
  done
}

cmd_sync() {
  no_more "$@"
  local s n
  for s in "$SKILLS"/*/; do
    n=$(basename "$s"); [ "$n" = "_TEMPLATE" ] && continue
    [ -f "$s/SKILL.md" ] || continue
    link_skill "$n"
  done
  echo "synced $(ls -d "$SKILLS"/*/ | grep -vc _TEMPLATE) skill(s) into ${LINK_DIRS[*]}"
}

cmd_skill() {
  case "${1:-}" in
    new)
      local name="${2:-}"; [ -n "$name" ] || die "usage: hub skill new <kebab-name>"
      case "$name" in -*|*[!a-z0-9-]*) die "name must be kebab-case (a-z 0-9 -) and not start with -" ;; esac
      [ $# -le 2 ] || die "unexpected argument '$3'"
      [ -e "$SKILLS/$name" ] && die "skill '$name' already exists"
      mkdir -p "$SKILLS/$name/scripts"
      sed "s/SKILL_NAME/$name/g" "$SKILLS/_TEMPLATE/SKILL.md" > "$SKILLS/$name/SKILL.md"
      link_skill "$name"
      echo "created $SKILLS/$name/SKILL.md (linked). Fill it in: description, procedure, scripts, gotchas, last verified."
      ;;
    list)
      shift; no_more "$@"
      local s n desc
      for s in "$SKILLS"/*/; do
        n=$(basename "$s"); [ "$n" = "_TEMPLATE" ] && continue
        desc=$(grep -m1 '^description:' "$s/SKILL.md" 2>/dev/null | sed 's/^description: *//' | cut -c1-110)
        printf '%-22s %s\n' "$n" "$desc"
      done
      ;;
    *) die "usage: hub skill new <name> | hub skill list" ;;
  esac
}

# Pick the facts a digest shows from a kb file: newest first, each shortened to HUB_DIGEST_WIDTH chars,
# until HUB_DIGEST_FACTS facts or HUB_DIGEST_BYTES chars are used. Fills DIGEST_LINES (oldest first),
# DIGEST_TOTAL, DIGEST_SHOWN, DIGEST_CUT. Character-safe in a UTF-8 locale.
digest_select() {
  local f="$1" max="${HUB_DIGEST_FACTS:-40}" w="${HUB_DIGEST_WIDTH:-220}" budget="${HUB_DIGEST_BYTES:-3000}"
  case "$max" in ''|*[!0-9]*) max=40 ;; esac
  case "$w" in ''|*[!0-9]*) w=220 ;; esac; [ "$w" -ge 40 ] || w=40
  case "$budget" in ''|*[!0-9]*) budget=3000 ;; esac
  local LC_ALL; LC_ALL=$(locale -a 2>/dev/null | grep -iE '^(en_US|C)\.utf-?8$' | head -1); [ -n "$LC_ALL" ] || unset LC_ALL
  local lines=() line i s used=0
  while IFS= read -r line; do lines+=("$line"); done < <(grep '^- ' "$f" || true)
  DIGEST_LINES=(); DIGEST_TOTAL=${#lines[@]}; DIGEST_SHOWN=0; DIGEST_CUT=0
  for ((i=DIGEST_TOTAL-1; i>=0 && DIGEST_SHOWN<max; i--)); do
    s=${lines[$i]}
    if [ ${#s} -gt "$w" ]; then s="${s:0:$((w-1))}…"; fi
    [ $((used + ${#s} + 1)) -le "$budget" ] || break
    [ "$s" = "${lines[$i]}" ] || DIGEST_CUT=$((DIGEST_CUT+1))
    used=$((used + ${#s} + 1))
    DIGEST_LINES=("$s" ${DIGEST_LINES[@]+"${DIGEST_LINES[@]}"})
    DIGEST_SHOWN=$((DIGEST_SHOWN+1))
  done
}

# Session-start block. Prints this project's kb facts in full (they are short, and an agent
# told to "run hub kb" often doesn't), unread messages, and when the other agent last worked
# in THIS project. Never prints another agent's message text or activity from other projects.
cmd_digest() {
  local agent="${1:-}"; [ -n "$agent" ] || die "usage: hub digest <agent>"
  not_flag "$agent"; [ $# -le 1 ] || die "unexpected argument '$2'"
  local proj; proj=$(project_name)
  local out=""
  local pf="$KB/projects/$proj.md"
  if [ -f "$pf" ]; then
    digest_select "$pf"
    if [ "$DIGEST_TOTAL" -gt 0 ]; then
      local note=""
      [ "$DIGEST_SHOWN" -lt "$DIGEST_TOTAL" ] && note+=", newest $DIGEST_SHOWN of $DIGEST_TOTAL shown"
      [ "$DIGEST_CUT" -gt 0 ] && note+=", $DIGEST_CUT shortened (…)"
      if [ -n "$note" ]; then note="${note#, }; full text: hub kb $proj"; else note="kb/projects/$proj.md"; fi
      out+="kb facts for $proj ($note):"$'\n'
      local l; for l in "${DIGEST_LINES[@]}"; do out+="$l"$'\n'; done
    fi
  fi
  local n; n=$(sq "SELECT count(*) FROM messages WHERE to_agent=$(q "$agent") AND read_at IS NULL")
  if [ "$n" != "0" ]; then out+=$(cmd_inbox "$agent")$'\n'; fi
  local qn; qn=$(sq "SELECT count(*) FROM feedback WHERE status='queued'")
  if [ "$qn" != "0" ]; then
    out+="council: $qn hub improvement(s) queued for a supervised session (hub feedback list --status queued); apply, test and report them to the user when it fits the task, or close them"$'\n'
  fi
  local last; last=$(sq "SELECT agent||' last active here: '||ts FROM events WHERE agent<>$(q "$agent") AND project=$(q "$proj") ORDER BY id DESC LIMIT 1")
  [ -n "$last" ] && out+="$last"$'\n'
  [ -n "$out" ] && printf '[agent-hub]\n%s' "$out"
  return 0
}

# Improvement feedback about the hub itself (skills, kb, CLI, hooks, rules). Read by the council.
FEEDBACK_AREAS="kb skill cli hooks rules other"
FEEDBACK_STATUSES="open done rejected queued"
cmd_feedback() {
  case "${1:-}" in
    list)
      shift
      local where="status='open'"
      case "${1:-}" in '') ;; --all) where="1=1" ;; --status) [ -n "${2:-}" ] || die "--status needs a value"; where="status=$(q "$2")"; shift ;; *) die "usage: hub feedback list [--all | --status <s>]" ;; esac
      [ $# -le 1 ] || die "unexpected argument '$2'"
      local rows; rows=$(sq "SELECT '#'||id||'  '||ts||'  '||agent||coalesce('  ['||project||']','')||'  ('||area||', '||status||')'||char(10)||'    '||replace(body,char(10),char(10)||'    ')||coalesce(char(10)||'    -> '||resolution,'') FROM feedback WHERE $where ORDER BY id")
      if [ -z "$rows" ]; then echo "feedback: none"; else printf '%s\n' "$rows"; fi
      ;;
    close)
      local id="${2:-}" st="${3:-}" note="${4:-}"
      [ -n "$id" ] && [ -n "$st" ] || die "usage: hub feedback close <id> <done|rejected|queued> [resolution]"
      case "$id" in *[!0-9]*) die "feedback id must be a number" ;; esac
      case " $FEEDBACK_STATUSES " in *" $st "*) [ "$st" != open ] || die "close with done, rejected or queued" ;; *) die "status must be one of: done rejected queued" ;; esac
      [ $# -le 4 ] || die "too many arguments: quote the resolution"
      [ "$(sq "SELECT count(*) FROM feedback WHERE id=$id")" = 1 ] || die "no feedback #$id"
      sq "UPDATE feedback SET status=$(q "$st"), resolution=$(q "$note"), resolved_at=strftime('%Y-%m-%dT%H:%M:%SZ','now') WHERE id=$id"
      echo "feedback #$id -> $st"
      ;;
    ''|-h|--help) die "usage: hub feedback [--area <$(echo $FEEDBACK_AREAS | tr ' ' '|')>] <text> | list [--all|--status s] | close <id> <status> [resolution]" ;;
    *)
      local area=other
      if [ "$1" = "--area" ]; then
        [ $# -ge 2 ] || die "--area needs a value"
        area="$2"; shift 2
        case " $FEEDBACK_AREAS " in *" $area "*) ;; *) die "area must be one of: $FEEDBACK_AREAS" ;; esac
      fi
      not_flag "${1:-}"
      [ $# -eq 1 ] && [ -n "$1" ] || die "put the whole feedback in quotes: hub feedback [--area a] \"text\""
      local from="${HUB_AGENT:-unknown}"
      local id; id=$(sq "INSERT INTO feedback(agent,project,area,body) VALUES($(q "$from"),$(q "$(project_name)"),$(q "$area"),$(q "$1")); SELECT last_insert_rowid();")
      echo "feedback #$id recorded ($area); the council reviews open feedback"
      ;;
  esac
}

cmd_search() {
  [ $# -ge 1 ] || die "usage: hub search <text>"
  not_flag "$1"
  local term="$*" hits
  hits=$(cd "$HUB" && grep -rniIF -- "$term" kb skills 2>/dev/null | grep -v '^skills/_TEMPLATE/' | cut -c1-240 || true)
  if [ -z "$hits" ]; then
    echo "no matches for '$term' in kb/ or skills/"
    return 1
  fi
  printf '%s\n' "$hits"
  echo "($(printf '%s\n' "$hits" | wc -l | tr -d ' ') line(s) in $(printf '%s\n' "$hits" | cut -d: -f1 | sort -u | wc -l | tr -d ' ') file(s))"
}

# frontmatter field from a SKILL.md (single-line values only)
fm() { awk -v k="$2" 'NR==1&&$0!="---"{exit} NR>1&&$0=="---"{exit} index($0,k":")==1{sub("^"k":[ ]*","");print;exit}' "$1"; }

cmd_lint() {
  no_more "$@"
  local max="${HUB_DESC_MAX:-350}" errs=0 warns=0 total=0 count=0
  local s n f name desc len p rel d tgt
  err()  { echo "error  $*"; errs=$((errs+1)); }
  warn() { echo "warn   $*"; warns=$((warns+1)); }
  local names=()
  for s in "$SKILLS"/*/; do
    n=$(basename "$s"); [ "$n" = "_TEMPLATE" ] && continue
    f="$SKILLS/$n/SKILL.md"
    if [ ! -f "$f" ]; then err "skills/$n: no SKILL.md"; continue; fi
    names+=("$n"); count=$((count+1))
    name=$(fm "$f" name); desc=$(fm "$f" description)
    [ "$name" = "$n" ] || err "skills/$n: frontmatter name is '${name:-<missing>}', folder is '$n'"
    if [ -z "$desc" ]; then err "skills/$n: no one-line description (it is what makes the skill trigger)"; fi
    case "$desc" in '>'*|'|'*) err "skills/$n: description is a multi-line YAML block; put it on one line" ;; esac
    # disable-model-invocation skills are slash-command aliases: their description never loads into context
    if [ "$(fm "$f" disable-model-invocation)" != "true" ]; then
      len=$(printf '%s' "$desc" | LC_ALL=en_US.UTF-8 wc -m | tr -d ' '); total=$((total+len))
      [ "$len" -le "$max" ] || warn "skills/$n: description is $len chars (budget $max); it loads into every session"
    fi
    # declared outside dependencies: <!-- hub-lint: external ~/some/dir (optional reason) --> (one per line)
    local ext; ext=$(sed -nE 's/.*<!-- *hub-lint: *external +([^ ]+).*-->.*/\1/p' "$f" | sed -E "s#^~/#$HOME/#; s#^\\\$HOME/#$HOME/#")
    grep -qE 'SKILL_NAME|One or two lines\. What this does' "$f" && err "skills/$n: still contains template placeholder text"
    # absolute script paths: must exist; outside the hub is fragile
    while IFS= read -r p; do
      [ -n "$p" ] || continue
      case "$p" in *'<'*|*'>'*) continue ;; esac
      tgt="$p"; case "$tgt" in '~/'*) tgt="$HOME/${tgt#\~/}" ;; '$HOME/'*) tgt="$HOME/${tgt#\$HOME/}" ;; esac
      if [ ! -e "$tgt" ]; then err "skills/$n: references $p, which does not exist"
      else
        case "$tgt" in "$HUB"/*) continue ;; esac
        local declared=0 e
        for e in $ext; do case "$tgt" in "${e%/}"/*) declared=1 ;; esac; done
        [ "$declared" = 1 ] || warn "skills/$n: depends on $p, outside the hub (move it into skills/$n/scripts/, or declare it with <!-- hub-lint: external <dir> -->)"
      fi
    done < <(grep -oE '(~|\$HOME|/Users/[^/[:space:]]+)/[^[:space:]`"'"'"')]+\.(sh|bash|mjs|cjs|js|ts|py|php|rb)' "$f" | sort -u)
    # relative script paths: fine when they sit in the skill folder, otherwise they live in some repo
    while IFS= read -r rel; do
      [ -n "$rel" ] || continue
      case "$rel" in *'<'*|*'>'*) continue ;; esac
      [ -e "$SKILLS/$n/${rel#./}" ] || warn "skills/$n: mentions $rel, not in the skill folder (if it lives in a repo, make sure the repo tracks it)"
    done < <(grep -oE '(^|[[:space:]`(])\.?/?[A-Za-z0-9._-]+/[A-Za-z0-9._/-]+\.(sh|bash|mjs|cjs|js|ts|py)\b' "$f" | sed -E 's/^[[:space:]`(]//' | grep -vE '^(~|/|\$)' | sort -u)
  done
  # likely duplicates: two skill names sharing a word stem of 5+ letters (draft-it / drafting).
  # Skills that name each other are deliberately related (an alias, a procedure + its toolbox): skip those.
  local i j a b ta tb
  for ((i=0; i<${#names[@]}; i++)); do
    for ((j=i+1; j<${#names[@]}; j++)); do
      a=${names[$i]}; b=${names[$j]}
      if grep -qwF -- "$b" "$SKILLS/$a/SKILL.md" || grep -qwF -- "$a" "$SKILLS/$b/SKILL.md"; then continue; fi
      for ta in ${a//-/ }; do
        [ ${#ta} -ge 5 ] || continue
        for tb in ${b//-/ }; do
          [ ${#tb} -ge 5 ] || continue
          if [ "${ta:0:5}" = "${tb:0:5}" ]; then warn "skills/$a and skills/$b look like overlapping skills (shared word '${ta:0:5}'); merge them if they do the same job"; break 2; fi
        done
      done
    done
  done
  # links: every skill linked everywhere, no dangling hub links left behind
  for d in "${LINK_DIRS[@]}"; do
    [ -d "$d" ] || continue
    for n in ${names[@]+"${names[@]}"}; do
      [ -L "$d/$n" ] && [ "$(readlink "$d/$n")" = "$SKILLS/$n" ] || err "$d/$n is not linked to the hub (run 'hub sync')"
    done
    for p in "$d"/*; do
      [ -L "$p" ] || continue
      case "$(readlink "$p")" in "$SKILLS"/*) [ -e "$p" ] || err "$p is a dangling link into the hub (remove it)" ;; esac
    done
  done
  # kb: index entries point at real files, every file is in the index
  if [ -f "$KB/INDEX.md" ]; then
    while IFS= read -r rel; do
      [ -f "$KB/$rel" ] || err "kb/INDEX.md links $rel, which does not exist"
    done < <(grep -oE '\]\((projects|topics)/[^)]+\.md\)' "$KB/INDEX.md" | sed -E 's/^\]\(//; s/\)$//')
    while IFS= read -r p; do
      rel=${p#"$KB"/}
      grep -qF "($rel)" "$KB/INDEX.md" || warn "kb/$rel is not listed in kb/INDEX.md"
    done < <(find "$KB/projects" "$KB/topics" -name '*.md' 2>/dev/null | sort)
    # project files feed the session-start digest: flag the ones that no longer fit its budget
    while IFS= read -r p; do
      digest_select "$p"
      [ "$DIGEST_SHOWN" -ge "$DIGEST_TOTAL" ] || warn "kb/${p#"$KB"/}: session digest fits only the newest $DIGEST_SHOWN of $DIGEST_TOTAL facts; drop stale ones or move long detail into a topics/ file"
    done < <(find "$KB/projects" -name '*.md' 2>/dev/null | sort)
  fi
  echo "lint: $count skill(s), model-visible descriptions total $total chars; $errs error(s), $warns warning(s)"
  [ "$errs" -eq 0 ]
}

cmd_ask() {
  local who="${1:-}" question="${2:-}"
  [ -n "$who" ] && [ -n "$question" ] || die "usage: hub ask <claude|codex> <question>"
  [ $# -le 2 ] || die "too many arguments: put the question in quotes"
  case "$who" in
    claude) need claude; claude -p "$question" ;;
    codex)  command -v codex >/dev/null 2>&1 || die "codex CLI not installed. Install: npm i -g @openai/codex"
            codex exec "$question" ;;
    *) die "unknown agent '$who'" ;;
  esac
}

cmd_status() {
  no_more "$@"
  echo "hub: $HUB"
  echo "skills: $(ls -d "$SKILLS"/*/ | grep -vc _TEMPLATE)"
  echo "kb files: $(find "$KB" -name '*.md' ! -name INDEX.md | wc -l | tr -d ' ')"
  echo "messages: $(sq 'SELECT count(*) FROM messages') total, unread by agent: $(sq "SELECT coalesce(group_concat(to_agent||'='||c, ', '),'none') FROM (SELECT to_agent, count(*) c FROM messages WHERE read_at IS NULL GROUP BY to_agent)")"
  echo "events: $(sq 'SELECT count(*) FROM events')"
  local d bad=0 n
  for d in "${LINK_DIRS[@]}"; do
    n=0; for s in "$SKILLS"/*/; do
      sk=$(basename "$s"); [ "$sk" = "_TEMPLATE" ] && continue
      [ -L "$d/$sk" ] && [ "$(readlink "$d/$sk")" = "$SKILLS/$sk" ] && n=$((n+1)) || bad=$((bad+1))
    done
    echo "links in $d: $n ok"
  done
  [ "$bad" = "0" ] || echo "unlinked or wrong: $bad (run 'hub sync')"
  echo "codex cli: $(command -v codex || echo 'not installed')   claude cli: $(command -v claude || echo 'not installed')"
}

cmd="${1:-help}"; shift || true
case "$cmd" in
  inbox) cmd_inbox "$@" ;;
  post) cmd_post "$@" ;;
  ack) cmd_ack "$@" ;;
  log) cmd_log "$@" ;;
  activity) cmd_activity "$@" ;;
  kb) cmd_kb "$@" ;;
  note) cmd_note "$@" ;;
  skill) cmd_skill "$@" ;;
  sync) cmd_sync "$@" ;;
  digest) cmd_digest "$@" ;;
  search) cmd_search "$@" ;;
  feedback) cmd_feedback "$@" ;;
  council) [ -x "$HUB/council/run.sh" ] || die "council not installed ($HUB/council/run.sh)"; exec "$HUB/council/run.sh" "$@" ;;
  lint) cmd_lint "$@" ;;
  ask) cmd_ask "$@" ;;
  status) cmd_status "$@" ;;
  help|-h|--help) usage ;;
  *) printf "hub: unknown command '%s'\n\n" "$cmd" >&2; usage >&2; exit 1 ;;
esac
