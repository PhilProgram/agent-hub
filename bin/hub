#!/usr/bin/env bash
# hub — shared library CLI for local AI agents (Claude Code, Codex, ...).
# Storage: ~/agent-hub (skills/, kb/, bus.db). Needs bash 3.2+ and sqlite3.
set -euo pipefail

HUB="${HUB_HOME:-$HOME/agent-hub}"
DB="$HUB/bus.db"
SKILLS="$HUB/skills"
KB="$HUB/kb"
# Every place an agent looks for skills. Each canonical skill dir gets a symlink in each.
LINK_DIRS=("$HOME/.claude/skills" "$HOME/.codex/skills" "$HOME/.agents/skills")

usage() {
  cat <<'USAGE'
hub — shared skills, knowledge base and message bus for local agents

  hub inbox <agent> [--all]              unread (or all) messages addressed to <agent>
  hub post <to> <subject> [body]         leave a message (sender from HUB_AGENT or --from <name>)
  hub ack <id>|all <agent>               mark a message (or all for <agent>) as read
  hub activity [n]                       last n events from all agents (default 20)
  hub log <agent> <kind> <detail>        record an event (used by hooks; agents may use it too)
  hub kb [name]                          print kb/INDEX.md, or kb/projects/<name>.md / kb/topics/<name>.md
  hub note <projects|topics>/<name> <text>   append one fact; creates the file and indexes it
  hub skill new <name>                   scaffold skills/<name>/SKILL.md from the template and link it
  hub skill list                         skills with their one-line descriptions
  hub sync                               (re)link every skill into ~/.claude/skills, ~/.codex/skills, ~/.agents/skills
  hub digest <agent>                     short block for session-start hooks (empty when nothing new)
  hub ask <claude|codex> <question>      ask the other agent as a subprocess (costs tokens)
  hub status                             counts and link health
USAGE
}

die() { printf 'hub: %s\n' "$*" >&2; exit 1; }
need() { command -v "$1" >/dev/null 2>&1 || die "$1 not found"; }
need sqlite3

sq() { sqlite3 -batch "$DB" "$@"; }
# SQL string literal
q() { printf "'%s'" "${1//\'/\'\'}"; }

init_db() {
  [ -f "$DB" ] && return 0
  sq >/dev/null <<'SQL'
PRAGMA journal_mode=WAL;
CREATE TABLE IF NOT EXISTS messages (
  id INTEGER PRIMARY KEY,
  ts TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%SZ','now')),
  from_agent TEXT NOT NULL,
  to_agent TEXT NOT NULL,
  project TEXT,
  subject TEXT NOT NULL,
  body TEXT,
  read_at TEXT
);
CREATE TABLE IF NOT EXISTS events (
  id INTEGER PRIMARY KEY,
  ts TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%SZ','now')),
  agent TEXT NOT NULL,
  project TEXT,
  kind TEXT NOT NULL,
  detail TEXT
);
CREATE INDEX IF NOT EXISTS messages_to_unread ON messages(to_agent, read_at);
SQL
}
init_db

project_name() { basename "${HUB_PROJECT:-$PWD}"; }

cmd_inbox() {
  local agent="${1:-}"; [ -n "$agent" ] || die "usage: hub inbox <agent> [--all]"
  local where="to_agent=$(q "$agent")"
  [ "${2:-}" = "--all" ] || where="$where AND read_at IS NULL"
  local n; n=$(sq "SELECT count(*) FROM messages WHERE $where")
  if [ "$n" = "0" ]; then echo "inbox ($agent): empty"; return 0; fi
  echo "inbox ($agent): $n message(s)"
  sq "SELECT '#'||id||'  '||ts||'  from '||from_agent||coalesce('  ['||project||']','')||'  '||subject||char(10)||coalesce('    '||replace(body,char(10),char(10)||'    '),'') FROM messages WHERE $where ORDER BY id"
}

cmd_post() {
  local from="${HUB_AGENT:-}"
  if [ "${1:-}" = "--from" ]; then from="$2"; shift 2; fi
  local to="${1:-}" subject="${2:-}" body="${3:-}"
  [ -n "$to" ] && [ -n "$subject" ] || die "usage: hub post [--from <me>] <to> <subject> [body]"
  [ -n "$from" ] || die "sender unknown: set HUB_AGENT or pass --from <me>"
  [ "$body" = "-" ] && body=$(cat)
  local id; id=$(sq "INSERT INTO messages(from_agent,to_agent,project,subject,body) VALUES($(q "$from"),$(q "$to"),$(q "$(project_name)"),$(q "$subject"),$(q "$body")); SELECT last_insert_rowid();")
  echo "posted #$id to $to"
}

cmd_ack() {
  local id="${1:-}"; [ -n "$id" ] || die "usage: hub ack <id>|all <agent>"
  if [ "$id" = "all" ]; then
    local agent="${2:-}"; [ -n "$agent" ] || die "usage: hub ack all <agent>"
    sq "UPDATE messages SET read_at=strftime('%Y-%m-%dT%H:%M:%SZ','now') WHERE to_agent=$(q "$agent") AND read_at IS NULL"
  else
    case "$id" in *[!0-9]*) die "message id must be a number" ;; esac
    sq "UPDATE messages SET read_at=strftime('%Y-%m-%dT%H:%M:%SZ','now') WHERE id=$id"
  fi
  echo "acked"
}

cmd_log() {
  local agent="${1:-}" kind="${2:-}" detail="${3:-}"
  [ -n "$agent" ] && [ -n "$kind" ] || die "usage: hub log <agent> <kind> [detail]"
  sq "INSERT INTO events(agent,project,kind,detail) VALUES($(q "$agent"),$(q "$(project_name)"),$(q "$kind"),$(q "$detail"))"
}

cmd_activity() {
  local n="${1:-20}"
  sq "SELECT ts||'  '||agent||coalesce('  ['||project||']','')||'  '||kind||coalesce('  '||substr(replace(detail,char(10),' '),1,160),'') FROM events ORDER BY id DESC LIMIT $n"
}

kb_path() {
  local name="$1"
  case "$name" in
    projects/*|topics/*) echo "$KB/$name.md" ;;
    *) if [ -f "$KB/projects/$name.md" ]; then echo "$KB/projects/$name.md";
       elif [ -f "$KB/topics/$name.md" ]; then echo "$KB/topics/$name.md";
       else echo "$KB/topics/$name.md"; fi ;;
  esac
}

cmd_kb() {
  if [ -z "${1:-}" ]; then cat "$KB/INDEX.md"; return 0; fi
  local f; f=$(kb_path "$1")
  [ -f "$f" ] || die "no kb file for '$1' (would be $f)"
  cat "$f"
}

index_add() {
  local rel="$1" name; name=$(basename "$rel" .md)
  grep -q "($rel)" "$KB/INDEX.md" && return 0
  local section; case "$rel" in projects/*) section="## Projects" ;; *) section="## Topics" ;; esac
  # put the link right after its section header
  awk -v sec="$section" -v line="- [$name]($rel)" '{ print } $0==sec { print line }' "$KB/INDEX.md" > "$KB/INDEX.md.tmp"
  mv "$KB/INDEX.md.tmp" "$KB/INDEX.md"
}

cmd_note() {
  local target="${1:-}" text="${2:-}"
  [ -n "$target" ] && [ -n "$text" ] || die "usage: hub note <projects|topics>/<name> <text>"
  case "$target" in projects/*|topics/*) ;; *) die "target must start with projects/ or topics/" ;; esac
  local f="$KB/$target.md"
  mkdir -p "$(dirname "$f")"
  [ -f "$f" ] || printf '# %s\n\n' "$(basename "$target")" > "$f"
  printf -- '- %s (%s%s)\n' "$text" "$(date +%Y-%m-%d)" "${HUB_AGENT:+, $HUB_AGENT}" >> "$f"
  index_add "$target.md"
  echo "noted in $target.md"
}

link_skill() {
  local name="$1" d dst src
  src="$SKILLS/$name"
  for d in "${LINK_DIRS[@]}"; do
    mkdir -p "$d"; dst="$d/$name"
    if [ -L "$dst" ]; then
      [ "$(readlink "$dst")" = "$src" ] || ln -sfn "$src" "$dst"
    elif [ -e "$dst" ]; then
      echo "  skip $dst: exists and is not a link (move it into $SKILLS to share it)" >&2
    else
      ln -s "$src" "$dst"
    fi
  done
}

cmd_sync() {
  local s n
  for s in "$SKILLS"/*/; do
    n=$(basename "$s"); [ "$n" = "_TEMPLATE" ] && continue
    [ -f "$s/SKILL.md" ] || continue
    link_skill "$n"
  done
  echo "synced $(ls -d "$SKILLS"/*/ | grep -vc _TEMPLATE) skill(s) into ${LINK_DIRS[*]}"
}

cmd_skill() {
  case "${1:-}" in
    new)
      local name="${2:-}"; [ -n "$name" ] || die "usage: hub skill new <kebab-name>"
      case "$name" in *[!a-z0-9-]*) die "name must be kebab-case: a-z 0-9 -" ;; esac
      [ -e "$SKILLS/$name" ] && die "skill '$name' already exists"
      mkdir -p "$SKILLS/$name/scripts"
      sed "s/SKILL_NAME/$name/g" "$SKILLS/_TEMPLATE/SKILL.md" > "$SKILLS/$name/SKILL.md"
      link_skill "$name"
      echo "created $SKILLS/$name/SKILL.md (linked). Fill it in: description, procedure, scripts, gotchas, last verified."
      ;;
    list)
      local s n desc
      for s in "$SKILLS"/*/; do
        n=$(basename "$s"); [ "$n" = "_TEMPLATE" ] && continue
        desc=$(grep -m1 '^description:' "$s/SKILL.md" 2>/dev/null | sed 's/^description: *//' | cut -c1-110)
        printf '%-22s %s\n' "$n" "$desc"
      done
      ;;
    *) die "usage: hub skill new <name> | hub skill list" ;;
  esac
}

cmd_digest() {
  local agent="${1:-}"; [ -n "$agent" ] || die "usage: hub digest <agent>"
  local n; n=$(sq "SELECT count(*) FROM messages WHERE to_agent=$(q "$agent") AND read_at IS NULL")
  local proj; proj=$(project_name)
  local out=""
  if [ "$n" != "0" ]; then out+=$(cmd_inbox "$agent")$'\n'; fi
  local pf="$KB/projects/$proj.md"
  if [ -f "$pf" ] && [ "$(grep -c '^- ' "$pf")" != "0" ]; then
    out+="kb/projects/$proj.md has $(grep -c '^- ' "$pf") fact(s): run 'hub kb $proj' before exploring."$'\n'
  fi
  local last; last=$(sq "SELECT ts||' '||agent||' '||kind||coalesce(' '||substr(replace(detail,char(10),' '),1,100),'') FROM events WHERE agent<>$(q "$agent") ORDER BY id DESC LIMIT 1")
  [ -n "$last" ] && out+="other agent last seen: $last"$'\n'
  [ -n "$out" ] && printf '[agent-hub] %s\n' "$out"
  return 0
}

cmd_ask() {
  local who="${1:-}" question="${2:-}"
  [ -n "$who" ] && [ -n "$question" ] || die "usage: hub ask <claude|codex> <question>"
  case "$who" in
    claude) need claude; claude -p "$question" ;;
    codex)  command -v codex >/dev/null 2>&1 || die "codex CLI not installed. Install: npm i -g @openai/codex"
            codex exec "$question" ;;
    *) die "unknown agent '$who'" ;;
  esac
}

cmd_status() {
  echo "hub: $HUB"
  echo "skills: $(ls -d "$SKILLS"/*/ | grep -vc _TEMPLATE)"
  echo "kb files: $(find "$KB" -name '*.md' ! -name INDEX.md | wc -l | tr -d ' ')"
  echo "messages: $(sq 'SELECT count(*) FROM messages') total, unread by agent: $(sq "SELECT coalesce(group_concat(to_agent||'='||c, ', '),'none') FROM (SELECT to_agent, count(*) c FROM messages WHERE read_at IS NULL GROUP BY to_agent)")"
  echo "events: $(sq 'SELECT count(*) FROM events')"
  local d bad=0 n
  for d in "${LINK_DIRS[@]}"; do
    n=0; for s in "$SKILLS"/*/; do
      sk=$(basename "$s"); [ "$sk" = "_TEMPLATE" ] && continue
      [ -L "$d/$sk" ] && [ "$(readlink "$d/$sk")" = "$SKILLS/$sk" ] && n=$((n+1)) || bad=$((bad+1))
    done
    echo "links in $d: $n ok"
  done
  [ "$bad" = "0" ] || echo "unlinked or wrong: $bad (run 'hub sync')"
  echo "codex cli: $(command -v codex || echo 'not installed')   claude cli: $(command -v claude || echo 'not installed')"
}

cmd="${1:-help}"; shift || true
case "$cmd" in
  inbox) cmd_inbox "$@" ;;
  post) cmd_post "$@" ;;
  ack) cmd_ack "$@" ;;
  log) cmd_log "$@" ;;
  activity) cmd_activity "$@" ;;
  kb) cmd_kb "$@" ;;
  note) cmd_note "$@" ;;
  skill) cmd_skill "$@" ;;
  sync) cmd_sync "$@" ;;
  digest) cmd_digest "$@" ;;
  ask) cmd_ask "$@" ;;
  status) cmd_status "$@" ;;
  help|-h|--help) usage ;;
  *) usage; exit 1 ;;
esac
